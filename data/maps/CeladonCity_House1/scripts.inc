	msgbox CeladonCity_House1_Text_ShippedMonsAsSlotPrizes, MSGBOX_NPC
	end

CeladonCity_House1_EventScript_Rocket2::
	goto_if_set FLAG_DEFEATED_LEADER_GIOVANNI, CeladonCity_House1_EventScript_Rocket2RocketDisbanded
