	end

CeladonCity_House1_EventScript_RocketChiefRocketDisbanded::
	msgbox CeladonCity_House1_Text_CalmDownYouTwo, MSGBOX_NPC
	end

CeladonCity_House1_EventScript_Rocket1RocketDisbanded::
